# Token de tu bot de Telegram (obtenelo de @BotFather)
TELEGRAM_TOKEN=tu_token_aqui

# Tu chat ID de Telegram (lo obtenés enviando /start al bot)
TELEGRAM_OWNER_ID=tu_chat_id_aqui

# Google Calendar (completar después de setup)
GOOGLE_CREDENTIALS_JSON={...contenido completo del JSON de la cuenta de servicio...}
GOOGLE_CALENDAR_ID=primary
GOOGLE_DRIVE_FOLDER_ID=

# Base de datos en el volumen de Railway (para no perder datos en cada deploy)
DB_PATH=/data/excursions.db

# Interpretación de mensajes con IA (opcional pero recomendado)
ANTHROPIC_API_KEY=
